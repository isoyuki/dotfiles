{
  "title": "Caps Lock: tap Escape, hold Hyper",
  "rules": [
    {
      "description": "Caps Lock: tap Escape, hold Hyper (cmd+ctrl+opt+shift)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "caps_lock", "modifiers": { "optional": ["any"] } },
          "to": [
            {
              "key_code": "left_shift",
              "modifiers": ["left_command", "left_control", "left_option"]
            }
          ],
          "to_if_alone": [{ "key_code": "escape" }]
        }
      ]
    }
  ]
}
