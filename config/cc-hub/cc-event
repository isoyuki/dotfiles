#!/bin/sh
# Claude Code hook: append one event line for cc-hubd. Never exit 2 (it blocks Claude).
# No tool_input is logged: tool arguments can carry tokens or customer IDs.
d="$HOME/.local/state/cc"
mkdir -p "$d"
command -v jq >/dev/null 2>&1 || exit 0
jq -c --arg ts "$(date +%s)" '{ts:($ts|tonumber), ev:.hook_event_name, sid:.session_id, cwd:.cwd,
  mode:.permission_mode, ntype:(.notification_type // null), err:(.error // null),
  msg:((.message // .last_assistant_message // "") | tostring | .[0:400])}' >>"$d/events.jsonl" 2>/dev/null
exit 0
