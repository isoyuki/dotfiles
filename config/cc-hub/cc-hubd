#!/usr/bin/env python3
"""cc-hubd: local state store for Claude Code sessions.

Inputs: hook events in ~/.local/state/cc/events.jsonl (cc-event) and
`claude agents --json --all` polled every POLL seconds.
Output: SQLite at ~/.local/state/cc/hub.db and HTTP on 127.0.0.1 only.
"""
import json
import os
import re
import sqlite3
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOST, PORT = "127.0.0.1", int(os.environ.get("CC_HUB_PORT", "7777"))
STATE = os.path.expanduser("~/.local/state/cc")
EVENTS = os.path.join(STATE, "events.jsonl")
DB = os.path.join(STATE, "hub.db")
WEB = os.path.join(os.path.dirname(os.path.realpath(__file__)), "web")
POLL = 8
NOTIFY_COOLDOWN = 120
WIP_WORKING, WIP_REVIEW = 4, 3
ISSUE_KEY = re.compile(r"\b[A-Z][A-Z0-9]+-\d+\b")

NEEDS_INPUT_NTYPES = {"permission_prompt", "agent_needs_input", "elicitation_dialog"}
POLL_STATE = {"working": "working", "blocked": "needs_input", "done": "done",
              "failed": "failed", "stopped": "stopped", "busy": "working", "idle": "idle"}

lock = threading.Lock()
changed = threading.Condition(lock)
version = 0
notified = {}  # sid -> last notification time
wip_warned = False


def db():
    c = sqlite3.connect(DB, check_same_thread=False)
    c.row_factory = sqlite3.Row
    c.execute("""CREATE TABLE IF NOT EXISTS sessions(
        sid TEXT PRIMARY KEY, id TEXT, key TEXT, name TEXT, kind TEXT, cwd TEXT,
        repo TEXT, branch TEXT, state TEXT, waiting_for TEXT, last_msg TEXT,
        mode TEXT, started_at INTEGER, updated_at INTEGER)""")
    c.execute("CREATE TABLE IF NOT EXISTS metrics(ts INTEGER, state TEXT, n INTEGER)")
    return c


conn = db()


def emacs_frontmost():
    try:
        front = subprocess.run(["lsappinfo", "info", "-only", "name", "front"], capture_output=True,
                               text=True, timeout=2).stdout
        return "Emacs" in front
    except Exception:
        return False


def notify(title, text):
    """macOS notification, secondary to the Emacs modeline: skipped while Emacs is in front."""
    if emacs_frontmost():
        return
    script = 'display notification %s with title %s' % (json.dumps(text), json.dumps(title))
    subprocess.Popen(["osascript", "-e", script], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def git_info(cwd, cache):
    if cwd in cache:
        return cache[cwd]
    repo = branch = None
    try:
        out = subprocess.run(["git", "-C", cwd, "rev-parse", "--git-common-dir", "--abbrev-ref", "HEAD"],
                             capture_output=True, text=True, timeout=3).stdout.split("\n")
        common = os.path.abspath(os.path.join(cwd, out[0]))
        repo = os.path.basename(os.path.dirname(common)) if out[0] else None
        branch = out[1] or None
    except Exception:
        pass
    cache[cwd] = (repo, branch)
    return cache[cwd]


def set_state(sid, new_state, **fields):
    """Upsert a session. Caller holds lock. Fires the needs-input notification on transition."""
    row = conn.execute("SELECT * FROM sessions WHERE sid=?", (sid,)).fetchone()
    old = row["state"] if row else None
    now = int(time.time())
    fields = {k: v for k, v in fields.items() if v is not None}
    if row is None:
        conn.execute("INSERT INTO sessions(sid, updated_at) VALUES(?, ?)", (sid, now))
    cols = dict(fields, state=new_state or old)
    if (new_state and new_state != old) or "last_msg" in fields:
        cols["updated_at"] = now
    conn.execute("UPDATE sessions SET %s WHERE sid=?" % ", ".join("%s=?" % k for k in cols),
                 (*cols.values(), sid))
    if new_state == "needs_input" and old not in (None, "needs_input"):
        if time.time() - notified.get(sid, 0) > NOTIFY_COOLDOWN:
            notified[sid] = time.time()
            r = conn.execute("SELECT name, key, cwd FROM sessions WHERE sid=?", (sid,)).fetchone()
            label = r["key"] or r["name"] or os.path.basename(r["cwd"] or "") or sid[:8]
            notify("Claude needs input", "SPC l a: %s" % label)
    return old != new_state


poke_timer = None


def poke_emacs():
    subprocess.Popen(["emacsclient", "-n", "--eval", "(when (fboundp 'cc-hub-poke) (cc-hub-poke))"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def bump(poke=True):
    """Wake SSE clients; tell Emacs at most once a second."""
    global version, poke_timer
    version += 1
    changed.notify_all()
    if poke and (poke_timer is None or not poke_timer.is_alive()):
        poke_timer = threading.Timer(1.0, poke_emacs)
        poke_timer.daemon = True
        poke_timer.start()


def apply_event(e):
    sid = e.get("sid")
    if not sid:
        return False
    ev, ntype = e.get("ev"), e.get("ntype")
    state = {"SessionStart": "registered", "UserPromptSubmit": "working", "PermissionRequest": "needs_input",
             "Stop": "done", "StopFailure": "failed", "SessionEnd": "ended"}.get(ev)
    if ev == "Notification":
        state = "needs_input" if ntype in NEEDS_INPUT_NTYPES else None
    waiting = ntype if state == "needs_input" else ""
    msg = e.get("msg") or None
    if ev == "StopFailure":
        msg = "%s: %s" % (e.get("err") or "error", msg or "")
    if state is None and msg is None:
        return False
    cwd = e.get("cwd")
    set_state(sid, state, cwd=cwd, mode=e.get("mode"), last_msg=msg, waiting_for=waiting)
    return True


def tail_events():
    pos = 0
    while True:
        try:
            if os.path.getsize(EVENTS) < pos:
                pos = 0  # file rotated or truncated
            with open(EVENTS) as f:
                f.seek(pos)
                lines = f.readlines()
                pos = f.tell()
        except FileNotFoundError:
            lines = []
        if lines:
            with lock:
                any_change = False
                for line in lines:
                    try:
                        any_change |= apply_event(json.loads(line))
                    except ValueError:
                        continue
                conn.commit()
                if any_change:
                    bump()
        time.sleep(0.5)


def poll_agents():
    global wip_warned
    while True:
        try:
            out = subprocess.run(["claude", "agents", "--json", "--all"], capture_output=True,
                                 text=True, timeout=30).stdout
            agents = json.loads(out or "[]")
        except Exception as ex:
            print("poll failed: %s" % ex, file=sys.stderr)
            agents = None
        if agents is not None:
            cache = {}
            with lock:
                before = conn.execute("SELECT sid, state, last_msg FROM sessions").fetchall()
                live = set()
                for a in agents:
                    sid = a.get("sessionId")
                    if not sid:
                        continue
                    live.add(sid)
                    cwd = a.get("cwd") or ""
                    repo, branch = git_info(cwd, cache) if cwd else (None, None)
                    name = a.get("name") or ""
                    m = ISSUE_KEY.search(name)
                    raw = a.get("state") or a.get("status")
                    row = conn.execute("SELECT state FROM sessions WHERE sid=?", (sid,)).fetchone()
                    # Background sessions: agents --json is authoritative. Interactive: hooks know more.
                    if a.get("kind") == "background" or row is None:
                        state = POLL_STATE.get(raw, raw)
                    else:
                        state = row["state"]
                    set_state(sid, state, id=a.get("id") or str(a.get("pid") or ""), name=name,
                              key=m.group(0) if m else None, kind=a.get("kind"), cwd=cwd, repo=repo,
                              branch=branch, waiting_for=a.get("waitingFor"), started_at=a.get("startedAt"))
                for r in conn.execute("SELECT sid FROM sessions WHERE state NOT IN ('ended','done','failed','stopped')").fetchall():
                    if r["sid"] not in live:
                        set_state(r["sid"], "ended")
                conn.commit()
                working = conn.execute("SELECT count(*) FROM sessions WHERE state='working'").fetchone()[0]
                review = conn.execute("SELECT count(*) FROM sessions WHERE state='done' AND kind='background'").fetchone()[0]
                over = working > WIP_WORKING or review > WIP_REVIEW
                if over and not wip_warned:
                    notify("Claude WIP cap", "%d working, %d awaiting review" % (working, review))
                wip_warned = over
                now = int(time.time())
                for st, n in conn.execute("SELECT state, count(*) FROM sessions WHERE state != 'ended' GROUP BY state"):
                    conn.execute("INSERT INTO metrics VALUES(?, ?, ?)", (now, st, n))
                conn.execute("DELETE FROM metrics WHERE ts < ?", (now - 7 * 86400,))
                conn.commit()
                after = conn.execute("SELECT sid, state, last_msg FROM sessions").fetchall()
                bump(poke=[tuple(r) for r in before] != [tuple(r) for r in after])
        time.sleep(POLL)


def sessions(include_ended=False):
    q = "SELECT * FROM sessions"
    if not include_ended:
        q += " WHERE state != 'ended' OR updated_at > %d" % (time.time() - 3600)
    order = "CASE state WHEN 'needs_input' THEN 0 WHEN 'failed' THEN 1 WHEN 'working' THEN 2 WHEN 'done' THEN 3 ELSE 4 END"
    with lock:
        return [dict(r) for r in conn.execute(q + " ORDER BY %s, updated_at DESC" % order).fetchall()]


def summary():
    counts = {}
    for s in sessions():
        counts[s["state"]] = counts.get(s["state"], 0) + 1
    warn = " WIP!" if counts.get("working", 0) > WIP_WORKING or counts.get("done", 0) > WIP_REVIEW else ""
    return "in:%d run:%d done:%d fail:%d%s" % (counts.get("needs_input", 0), counts.get("working", 0),
                                               counts.get("done", 0), counts.get("failed", 0), warn)


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def send(self, body, ctype="application/json"):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = self.path.split("?")[0]
        if path == "/api/sessions.json":
            self.send(json.dumps(sessions("all=1" in self.path)))
        elif path == "/api/summary.txt":
            self.send(summary() + "\n", "text/plain; charset=utf-8")
        elif path == "/api/metrics.json":
            with lock:
                rows = conn.execute("SELECT ts, state, n FROM metrics WHERE ts > ? ORDER BY ts",
                                    (time.time() - 86400,)).fetchall()
            self.send(json.dumps([dict(r) for r in rows]))
        elif path == "/events":
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.end_headers()
            seen = -1
            try:
                while True:
                    with changed:
                        changed.wait_for(lambda: version != seen, timeout=15)
                        seen = version
                    self.wfile.write(("data: %s\n\n" % json.dumps(sessions())).encode())
                    self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError):
                return
        elif path in ("/", "/index.html"):
            with open(os.path.join(WEB, "index.html"), "rb") as f:
                self.send(f.read(), "text/html; charset=utf-8")
        else:
            self.send_error(404)


def main():
    os.makedirs(STATE, exist_ok=True)
    for fn in (tail_events, poll_agents):
        threading.Thread(target=fn, daemon=True).start()
    ThreadingHTTPServer.daemon_threads = True
    ThreadingHTTPServer((HOST, PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
